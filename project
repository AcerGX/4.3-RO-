{name:"Кобени",type:"human",power:65,speed:90,brain:78,bio:"Кобени — охотница на демонов, тревожная, внимательная.",psychology:"Страх и тревожность делают её быстрой и рациональной.", img:"https://avatars.mds.yandex.net/i?id=416d244354ee84e237c5a06fdc5ad29e_l-4984230-images-thumbs&n=13"}
];

const cardsContainer=document.getElementById('cardsContainer');
characters.forEach((char,i)=>{
let card=document.createElement('div');card.className='card';
card.onclick=()=>showBio(i);
card.innerHTML=`<img src="${char.img}"><h3>${char.name}</h3>`;
cardsContainer.appendChild(card);
});

function showBio(i){
let char=characters[i];
document.getElementById('bioName').innerText=char.name;
document.getElementById('bioText').innerText=char.bio;
document.getElementById('psychAnalysis').innerText=char.psychology;
document.getElementById('bio').style.display='block';
setTimeout(()=>{
document.getElementById('powerBar').style.width=char.power+'%';
document.getElementById('speedBar').style.width=char.speed+'%';
document.getElementById('brainBar').style.width=char.brain+'%';
},200);
}

function filterType(type){
document.querySelectorAll('.card').forEach((card,i)=>{
card.style.display=(type==='all'||characters[i].type===type)?'block':'none';
});
document.getElementById('bio').style.display='none';
}

function setTheme(theme){document.body.className=theme;}

const select1=document.getElementById('char1'); const select2=document.getElementById('char2');
characters.forEach((c,i)=>{
let o1=document.createElement('option');o1.value=i;o1.text=c.name;select1.appendChild(o1);
let o2=document.createElement('option');o2.value=i;o2.text=c.name;select2.appendChild(o2);
});

function compare(){
let c1=characters[select1.value],c2=characters[select2.value];
document.getElementById('result').innerHTML=`
<div class="compare-bars">
<div class="compare-column">
<h3>${c1.name}</h3>
Сила<div class="bar"><div class="bar-fill" style="width:${c1.power}%"></div></div>
Скорость<div class="bar"><div class="bar-fill" style="width:${c1.speed}%"></div></div>
Интеллект<div class="bar"><div class="bar-fill" style="width:${c1.brain}%"></div></div>
</div>
<div class="compare-column">
<h3>${c2.name}</h3>
Сила<div class="bar"><div class="bar-fill" style="width:${c2.power}%"></div></div>
Скорость<div class="bar"><div class="bar-fill" style="width:${c2.speed}%"></div></div>
Интеллект<div class="bar"><div class="bar-fill" style="width:${c2.brain}%"></div></div>
</div>
</div>`;
}

setInterval(()=>{document.querySelector('header h1').style.letterSpacing=Math.random()*5+'px';},800);
</script>
</body>
</html>
